[ghq]
	root = ~/repo
[commit]
	gpgsign = true
[include]
	path = ~/.gitconfig.local
[includeIf "gitdir:~/repo/github-personal/joe-yama/"]
	path = ~/.gitconfig-personal
[includeIf "gitdir:~/repo/github.com/joe-yama/"]
	path = ~/.gitconfig-personal
# chezmoi のソースディレクトリは ghq 配下 (~/repo/...) にないため個別に指定する
[includeIf "gitdir:~/dotfiles/"]
	path = ~/.gitconfig-personal
[core]
	autocrlf = false
	precomposeunicode = true
	eol = lf

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[gpg]
	format = ssh
# gpg.ssh.program はあえて設定しない = 既定の ssh-keygen を使う。
# 1Password の op-ssh-sign はコミットのたびに承認ダイアログを出すため撤去した。
# 署名鍵はディスク上の専用鍵 (~/.ssh/git-signing-*) — user.signingkey を参照。
[gtr "editor"]
	default = code
[alias]
	sw = switch
[init]
	defaultBranch = main
[diff]
	colorMoved = default
[merge]
	conflictstyle = zdiff3
[rerere]
	enabled = true
[fetch]
	prune = true
	pruneTags = true
[pull]
	rebase = true
[branch]
	sort = -committerdate
[pager]
	diff = delta
	log = delta
	reflog = delta
	show = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	side-by-side = true
	syntax-theme = Catppuccin Mocha

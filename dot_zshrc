# Workaround: Homebrew python@3.14 3.14.4 の pyexpat が system libexpat の
# _XML_SetAllocTrackerActivationThreshold シンボル欠落で dlopen 失敗する問題。
# Homebrew expat を DYLD_LIBRARY_PATH で先行させて回避する。
# Homebrew 側で修正 bottle が出たらこのブロックごと削除して brew upgrade すれば元に戻る。
__awsvault_expat_fix="/opt/homebrew/opt/expat/lib"
aws-vault() { DYLD_LIBRARY_PATH="${__awsvault_expat_fix}${DYLD_LIBRARY_PATH:+:${DYLD_LIBRARY_PATH}}" command aws-vault "$@"; }
aws()       { DYLD_LIBRARY_PATH="${__awsvault_expat_fix}${DYLD_LIBRARY_PATH:+:${DYLD_LIBRARY_PATH}}" command aws "$@"; }


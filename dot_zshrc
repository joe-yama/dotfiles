# Path to your Oh My Zsh installation.
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"
DISABLE_AUTO_TITLE="true"
zstyle ':omz:update' mode auto      # update automatically without asking
# Skip compaudit security check for faster compinit
ZSH_DISABLE_COMPFIX=true
# Docker CLI completions (fpath must be added before OMZ's compinit)
fpath=(/Users/user/.docker/completions $fpath)
plugins=(git aliases copypath history docker brew zsh-completions zsh-autosuggestions zsh-syntax-highlighting eza fzf tldr aws terraform)
source $ZSH/oh-my-zsh.sh

export LANG=en_US.UTF-8

# Preferred editor for local and remote sessions
if [[ -n $SSH_CONNECTION ]]; then
  export EDITOR='vim'
else
  export EDITOR='hx'
fi


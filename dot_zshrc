export PYENV_ROOT="$HOME/.pyenv"
[[ -d $PYENV_ROOT/bin ]] && export PATH="$PYENV_ROOT/bin:$PATH"
export PATH="$PYENV_ROOT/shims:$PATH"
# Lazy-load pyenv: full init deferred until first pyenv invocation
pyenv() {
  unfunction pyenv
  eval "$(command pyenv init - zsh)"
  pyenv "$@"
}

### Jujutsu ###
alias ljj="lazyjj"
# Cache jj completion (regenerate on version change)
_jj_comp_cache="$HOME/.cache/jj/completion.zsh"
if [[ ! -f "$_jj_comp_cache" ]] || [[ "$(jj --version)" != "$(head -1 "$_jj_comp_cache" | sed 's/^# //')" ]]; then
  mkdir -p "${_jj_comp_cache:h}"
  { echo "# $(jj --version)"; jj util completion zsh } > "$_jj_comp_cache"
fi
source "$_jj_comp_cache"



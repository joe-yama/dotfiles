### worktrunk ###
export WORKTRUNK_CONFIG_PATH="$HOME/.config/worktrunk/config.toml"
eval "$(wt config shell init zsh)"
# Subcommand aliases: wt sw/ls/rm
functions[__wt_orig]="$functions[wt]"
wt() {
  case "$1" in
    sw) shift; __wt_orig switch "$@" ;;
    ls) shift; __wt_orig list "$@" ;;
    rm) shift; __wt_orig remove "$@" ;;
    *)  __wt_orig "$@" ;;
  esac
}

# Machine-local overrides (not tracked)
[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local


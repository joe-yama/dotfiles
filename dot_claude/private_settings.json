{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "MCP_TIMEOUT": "120000"
  },
  "permissions": {
    "allow": [
      "Read(~/repo/**)",
      "Bash(rg:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git grep:*)",
      "Bash(git ls-files:*)",
      "Bash(git blame:*)",
      "Bash(git worktree list:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git stash:*)",
      "Bash(git restore:*)",
      "Bash(jj)",
      "Bash(jj log:*)",
      "Bash(jj describe:*)",
      "Bash(jj desc:*)",
      "Bash(jj status:*)",
      "Bash(jj st:*)",
      "Bash(jj diff:*)",
      "Bash(jj new:*)",
      "Bash(jj edit:*)",
      "Bash(jj bookmark:*)",
      "Bash(jj rebase:*)",
      "Bash(jj squash:*)",
      "Bash(jj absorb:*)",
      "Bash(jj git fetch:*)",
      "Bash(jj restore:*)",
      "Bash(jj abandon:*)",
      "Bash(jj show:*)",
      "Bash(jj op:*)",
      "Bash(jj undo:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr status:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run watch:*)",
      "Bash(gh repo view:*)",
      "Bash(gh release view:*)",
      "Bash(gh release list:*)",
      "Bash(gh search:*)",
      "Bash(gh auth status:*)",
      "Bash(npm run test:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run build:*)",
      "Bash(npm test:*)",
      "Bash(markdownlint:*)",
      "Bash(chezmoi apply:*)",
      "Bash(chezmoi diff:*)",
      "Bash(chezmoi verify:*)",
      "Bash(chezmoi status:*)",
      "Bash(chezmoi data:*)",
      "Bash(make apply)",
      "Bash(make diff)",
      "Bash(make doctor)",
      "Bash(aerospace reload-config)",
      "Bash(brew services restart sketchybar)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:github.com)",
      "WebSearch",
      "mcp__sonarqube__search*",
      "mcp__sonarqube__get*",
      "mcp__sonarqube__show*",
      "mcp__sonarqube__list*",
      "mcp__sonarqube__analyze_code_snippet",
      "mcp__atlassian__jira_get*",
      "mcp__atlassian__jira_search*",
      "mcp__atlassian__confluence_get*",
      "mcp__atlassian__confluence_search*"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.claude/.env)",
      "Bash(sudo:*)",
      "Bash(ln:*)"
    ],
    "ask": [
      "Bash(jj git push:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr close:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr review:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh release create:*)",
      "Bash(gh repo create:*)",
      "Bash(gh workflow run:*)",
      "Bash(rm:*)",
      "Bash(git clean:*)",
      "Bash(curl:*)",
      "Bash(wget:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "sonnet",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/permission-gate.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enableWorkflows": true,
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "skill-creator@claude-plugins-official": false,
    "superpowers@claude-plugins-official": true,
    "github@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": false,
    "hookify@claude-plugins-official": true,
    "caveman@caveman": false,
    "pyright-lsp@claude-plugins-official": false,
    "typescript-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    }
  },
  "outputStyle": "Concise",
  "language": "japanese",
  "sandbox": {
    "enabled": false,
    "allowUnsandboxedCommands": true,
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "codeload.github.com",
        "raw.githubusercontent.com",
        "objects.githubusercontent.com",
        "github.tmc-stargate.com",
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org"
      ]
    },
    "credentials": {
      "files": [
        {
          "path": "~/.ssh",
          "mode": "deny"
        },
        {
          "path": "~/.aws",
          "mode": "deny"
        },
        {
          "path": "~/.gnupg",
          "mode": "deny"
        },
        {
          "path": "~/.claude/.env",
          "mode": "deny"
        },
        {
          "path": "~/.config/op",
          "mode": "deny"
        }
      ]
    },
    "excludedCommands": [
      "chezmoi",
      "git",
      "jj",
      "gh",
      "op",
      "docker",
      "brew",
      "make",
      "aerospace"
    ]
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "high"
    },
    "claude-fable-5-1": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "verbose": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "environment": [
      "### Org-wide",
      "**Organization**: None configured",
      "**Cloud provider(s)**: None configured",
      "**Repository visibility**: assume private unless the remote host and repo name indicate otherwise, or a visibility check in the transcript shows public — gh visibility lookup was not queryable here; origin is github.com:joe-yama/dotfiles.git",
      "**Internal sharing / snippet hosting**: None configured — treat public paste/gist services as outside the trust boundary",
      "**Secrets management**: 1Password CLI (`op`) — used for `op://` template references and `op inject` caching to `$TMPDIR/claude-mcp-env` (0600, TTL 8h); commit signing keys live on-disk at `~/.ssh/git-signing-{work,personal}` and do not go through 1Password",
      "**Default / protected branches**: main (default) — protection status not queryable here (gh lookup unavailable)",
      "**CI/CD deploy targets**: None configured",
      "**Network posture**: None configured",
      "**Host containment**: None configured — assume Claude Code runs on an ordinary developer machine with open internet",
      "**Source control**: jj (colocated with git) for this repo; `git` reserved only for operations jj doesn't support (e.g. signing configs) — trusted repo and its remote only, no additional orgs configured",
      "**Trusted internal domains**: None configured",
      "**Trusted cloud buckets**: None configured",
      "**Key internal services**: `josukes-macbook-pro.tail97ab8.ts.net` (Tailscale host reachable from this project, seen 12× in contacted hosts)",
      "**Internal package registry**: None configured",
      "**Sensitive data locations & audiences**: files matching `*.secrets` (gitignored); `.tmpl` files referencing `op://vault/item/field`; `dot_claude/dot_env` (plain file with native `op://` references, cached to `$TMPDIR/claude-mcp-env`) — share only with audiences cleared at the [named+specifics] bar",
      "**Data retention / declassification**: None configured",
      "**Sensitive remote targets**: any namespace, host, or container whose name carries `prod` or `production` as a whole word or name segment",
      "**Protected deployment namespaces / environments**: None configured — fall back to the Sensitive remote targets heuristic",
      "**Protected IaC scopes**: IAM, RBAC, networking, quota, and node-pool resources; anything whose name or tag carries `prod` or `production` as a whole word or name segment",
      "### User-specific",
      "**Primary use of Claude Code**: dotfiles/chezmoi-managed macOS system configuration management (software development)",
      "**Trusted repo**: `/Users/joe/dotfiles` and its remote `github.com:joe-yama/dotfiles.git`",
      "**Org-specific CLIs**: `jj` (Jujutsu VCS, colocated with git — use jj not git for VCS ops), `chezmoi` (dotfiles apply/diff/verify), `hermes`, `op` (1Password CLI)",
      "**routine under /Users/joe/dotfiles/ prefix**: `chezmoi apply <target>`, `chezmoi diff <target>`, `chezmoi verify`, `jj` VCS operations (status, log, diff, describe, new, bookmark, git push/fetch, rebase, squash)"
    ]
  },
  "mcpServers": {
    "atlassian": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "mcp-atlassian"
      ]
    },
    "sonarqube": {
      "type": "stdio",
      "command": "docker",
      "args": [
        "run",
        "--init",
        "--pull=always",
        "-i",
        "--rm",
        "-e",
        "SONARQUBE_TOKEN",
        "-e",
        "SONARQUBE_ORG",
        "sonarsource/sonarqube-mcp"
      ]
    },
    "lucid": {
      "type": "http",
      "url": "https://mcp.lucid.app/mcp"
    },
    "aws-mcp": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "mcp-proxy-for-aws@latest",
        "https://aws-mcp.us-east-1.api.aws/mcp"
      ]
    }
  }
}

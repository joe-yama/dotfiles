{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Read(~/repo/**)",
      "Bash(rg:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git grep:*)",
      "Bash(git ls-files:*)",
      "Bash(git blame:*)",
      "Bash(git worktree list:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git stash:*)",
      "Bash(git restore:*)",
      "Bash(jj)",
      "Bash(jj log:*)",
      "Bash(jj describe:*)",
      "Bash(jj desc:*)",
      "Bash(jj status:*)",
      "Bash(jj st:*)",
      "Bash(jj diff:*)",
      "Bash(jj new:*)",
      "Bash(jj edit:*)",
      "Bash(jj bookmark:*)",
      "Bash(jj rebase:*)",
      "Bash(jj squash:*)",
      "Bash(jj absorb:*)",
      "Bash(jj git fetch:*)",
      "Bash(jj restore:*)",
      "Bash(jj abandon:*)",
      "Bash(jj show:*)",
      "Bash(jj op:*)",
      "Bash(jj undo:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr status:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run watch:*)",
      "Bash(gh repo view:*)",
      "Bash(gh release view:*)",
      "Bash(gh release list:*)",
      "Bash(gh search:*)",
      "Bash(gh auth status:*)",
      "Bash(npm run test:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run build:*)",
      "Bash(npm test:*)",
      "Bash(markdownlint:*)",
      "Bash(chezmoi apply:*)",
      "Bash(chezmoi diff:*)",
      "Bash(chezmoi verify:*)",
      "Bash(chezmoi status:*)",
      "Bash(chezmoi data:*)",
      "Bash(make apply)",
      "Bash(make diff)",
      "Bash(make doctor)",
      "Bash(aerospace reload-config)",
      "Bash(brew services restart sketchybar)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:github.com)",
      "WebSearch",
      "mcp__atlassian__jira_get*",
      "mcp__atlassian__jira_search*",
      "mcp__atlassian__confluence_get*",
      "mcp__atlassian__confluence_search*"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.claude/.env)",
      "Bash(sudo:*)",
      "Bash(ln:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(jj git push:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr close:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr review:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh release create:*)",
      "Bash(gh repo create:*)",
      "Bash(gh workflow run:*)",
      "Bash(rm:*)",
      "Bash(git clean:*)",
      "Bash(curl:*)",
      "Bash(wget:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/permission-gate.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "claude-md-management@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {},
  "language": "japanese",
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": true,
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "codeload.github.com",
        "raw.githubusercontent.com",
        "objects.githubusercontent.com",
        "github.tmc-stargate.com",
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org"
      ]
    },
    "filesystem": {
      "denyRead": [
        "~/.ssh"
      ],
      "allowRead": [
        "~/.ssh/config",
        "~/.ssh/config.d",
        "~/.ssh/known_hosts",
        "~/.ssh/git-signing-*",
        "~/.ssh/git-auth-*",
        "~/.ssh/github-ccoe*"
      ]
    },
    "credentials": {
      "files": [
        {
          "path": "~/.aws",
          "mode": "deny"
        },
        {
          "path": "~/.gnupg",
          "mode": "deny"
        },
        {
          "path": "~/.claude/.env",
          "mode": "deny"
        },
        {
          "path": "~/.config/op",
          "mode": "deny"
        }
      ]
    },
    "excludedCommands": [
      "chezmoi",
      "git",
      "jj",
      "gh",
      "brew",
      "make",
      "aerospace"
    ]
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    },
    "claude-fable-5-2": {
      "effortLevel": "high"
    }
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "verbose": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}

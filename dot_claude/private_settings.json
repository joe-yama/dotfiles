{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "MCP_TIMEOUT": "120000"
  },
  "permissions": {
    "allow": [
      "Read(./**/*)",
      "Bash(*-h*)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(cd *)",
      "Bash(pwd *)",
      "Bash(echo *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(find *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(jj)",
      "Bash(jj log *)",
      "Bash(jj describe *)",
      "Bash(jj desc *)",
      "Bash(jj status *)",
      "Bash(jj st *)",
      "Bash(jj diff *)",
      "Bash(jj new *)",
      "Bash(jj edit *)",
      "Bash(jj bookmark *)",
      "Bash(jj rebase *)",
      "Bash(jj squash *)",
      "Bash(jj absorb *)",
      "Bash(jj git fetch *)",
      "Bash(jj restore *)",
      "Bash(jj abandon *)",
      "Bash(jj show *)",
      "Bash(jj op *)",
      "Bash(jj undo *)",
      "Bash(chezmoi apply *)",
      "Bash(chezmoi diff *)",
      "Bash(chezmoi verify *)",
      "Bash(chezmoi status *)",
      "Bash(chezmoi data *)",
      "Bash(make apply)",
      "Bash(make diff)",
      "Bash(make doctor)",
      "Bash(aerospace reload-config)",
      "Bash(brew services restart sketchybar)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebSearch",
      "mcp__atlassian__*__read"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(~/.ssh/**)",
      "Bash(ln *)",
      "Bash(sudo *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(*git push *)",
      "Bash(jj git push *)",
      "Bash(*jj git push *)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/user/.config/zellij/plugins/zellaude-hook.sh",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/user/.config/zellij/plugins/zellaude-hook.sh",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/user/.config/zellij/plugins/zellaude-hook.sh",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/user/.config/zellij/plugins/zellaude-hook.sh",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/user/.config/zellij/plugins/zellaude-hook.sh",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/user/.config/zellij/plugins/zellaude-hook.sh",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/user/.config/zellij/plugins/zellaude-hook.sh",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/user/.config/zellij/plugins/zellaude-hook.sh",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/user/.config/zellij/plugins/zellaude-hook.sh",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/user/.config/zellij/plugins/zellaude-hook.sh",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "skill-creator@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "hookify@claude-plugins-official": true,
    "caveman@caveman": false,
    "pyright-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    }
  },
  "language": "japanese",
  "effortLevel": "high",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "verbose": true,
  "skipAutoPermissionPrompt": true,
  "mcpServers": {
    "atlassian": {
      "type": "stdio",
      "command": "sh",
      "args": [
        "-c",
        "op run --env-file ~/.claude/.env -- uvx mcp-atlassian"
      ]
    },
    "sonarqube": {
      "type": "stdio",
      "command": "sh",
      "args": [
        "-c",
        "op run --env-file ~/.claude/.env -- docker run --init --pull=always -i --rm -e SONARQUBE_TOKEN -e SONARQUBE_ORG sonarsource/sonarqube-mcp"
      ]
    },
    "lucid": {
      "type": "http",
      "url": "https://mcp.lucid.app/mcp"
    },
    "aws-mcp": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "mcp-proxy-for-aws@latest",
        "https://aws-mcp.us-east-1.api.aws/mcp"
      ]
    }
  }
}

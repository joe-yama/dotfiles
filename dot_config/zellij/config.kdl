plugins {
    attention location="file:~/.config/zellij/plugins/zellij-attention.wasm" {
        enabled true
    }
    autolock location="file:~/.config/zellij/plugins/zellij-autolock.wasm" {
        triggers "nvim|vim|git|fzf|zoxide|atuin"
        reaction "normal"
        watch_triggers "claude"
        watch_reaction "normal"
        watch_interval "1.0"
    }
}

load_plugins {
    attention
    autolock
}

default_layout "default"
show_startup_tips false
// 常時新規セッション運用のため、終了後のセッション保存（resurrect 用）は無効化する。
session_serialization false
// kitty keyboard protocol: IME ON でもモード内 Ctrl+<key> を一意に区別させるため有効化。
// これにより Ctrl+h/j（Backspace/Enter と衝突）や Ctrl+1-9（固有コード無し）も CSI-u で送られる。
// 無効化していた IME 未確定文字の描画バグは v0.44.1+ (PR #4951) で修正済み。
support_kitty_keyboard_protocol true

keybinds clear-defaults=true {
  shared {
    bind "Ctrl space" { SwitchToMode "pane"; }
    bind "Ctrl o" { Detach; }
    bind "Ctrl q" { Quit; }
  }
  pane {
    // ペイン操作 — bare キー（IME OFF 用）に Ctrl 版（IME ON 用）を併記。
    bind "h" "Ctrl h" { MoveFocus "left"; SwitchToMode "normal"; }
    bind "j" "Ctrl j" { MoveFocus "down"; SwitchToMode "normal"; }
    bind "k" "Ctrl k" { MoveFocus "up"; SwitchToMode "normal"; }
    bind "l" "Ctrl l" { MoveFocus "right"; SwitchToMode "normal"; }
    bind "v" "Ctrl v" { NewPane "right"; SwitchToMode "normal"; }
    bind "s" "Ctrl s" { NewPane "down"; SwitchToMode "normal"; }
    bind "q" "Ctrl q" { CloseFocus; SwitchToMode "normal"; }
    bind "g" "Ctrl g" {
      LaunchOrFocusPlugin "file:~/.config/zellij/plugins/ghost.wasm" {
        floating true
        shell "zsh"
        shell_flag "-ic"
      }
      SwitchToMode "normal"
    }

    // プラグイン
    bind "m" "Ctrl m" {
      LaunchOrFocusPlugin "file:~/.config/zellij/plugins/monocle.wasm" {
        floating true
        in_place true
        kiosk true
      }
      SwitchToMode "normal"
    }
    bind "f" "Ctrl f" {
      LaunchOrFocusPlugin "file:~/.config/zellij/plugins/zellij_forgot.wasm" {
        floating true
        "LOAD_ZELLIJ_BINDINGS" "true"
      }
      SwitchToMode "normal"
    }
    bind "w" "Ctrl w" {
      LaunchOrFocusPlugin "file:~/.config/zellij/plugins/room.wasm" {
        floating true
        ignore_case true
        quick_jump true
      }
      SwitchToMode "normal"
    }
    bind "b" "Ctrl b" {
      LaunchOrFocusPlugin "file:~/.config/zellij/plugins/harpoon.wasm" {
        floating true
        move_to_focused_tab true
      }
      SwitchToMode "normal"
    }
    // multitask: Ctrl c は pane 脱出（shared_except）に割当済みのため bare のみ。
    // IME ON 時の脱出は Esc で可能（Esc は IME に合成されない）。
    bind "c" {
      LaunchOrFocusPlugin "file:~/.config/zellij/plugins/multitask.wasm" {
        floating true
      }
      SwitchToMode "normal"
    }
    // タブ操作
    bind "t" "Ctrl t" {
      LaunchOrFocusPlugin "file:~/.config/zellij/plugins/zellij-newtab-plus.wasm" {
        floating true
        use_zoxide true
      }
      SwitchToMode "normal"
    }
    bind "x" "Ctrl x" { CloseTab; SwitchToMode "normal"; }
    bind "n" "Ctrl n" { GoToNextTab; SwitchToMode "normal"; }
    bind "p" "Ctrl p" { GoToPreviousTab; SwitchToMode "normal"; }
    // 数字ジャンプは IME ON では非対応（穴を容認）。理由:
    //   bare → IME が数字を食う / Ctrl → kitty protocol が数字を昇格せず届かない /
    //   Alt(+Shift) → AeroSpace のワークスペース切替・ウィンドウ移動が奪取。
    // IME ON 時のタブ移動は Ctrl+n / Ctrl+p の循環で代替する。bare は IME OFF 時に有効。
    bind "1" { GoToTab 1; SwitchToMode "normal"; }
    bind "2" { GoToTab 2; SwitchToMode "normal"; }
    bind "3" { GoToTab 3; SwitchToMode "normal"; }
    bind "4" { GoToTab 4; SwitchToMode "normal"; }
    bind "5" { GoToTab 5; SwitchToMode "normal"; }
    bind "6" { GoToTab 6; SwitchToMode "normal"; }
    bind "7" { GoToTab 7; SwitchToMode "normal"; }
    bind "8" { GoToTab 8; SwitchToMode "normal"; }
    bind "9" { GoToTab 9; SwitchToMode "normal"; }
    bind "r" "Ctrl r" { SwitchToMode "renametab"; TabNameInput 0; }

    // セッション操作
    bind "D" "Ctrl d" { Detach; }
    // built-in の session-manager（DL不要）。セッション切替・新規作成に使う。
    // 注: session_serialization false のため resurrect（終了済みセッション復活）は無効。
    // Ctrl s は NewPane に割当済みのため Ctrl+Shift+s を併記（構文が通らなければ空きキーに変更）。
    bind "S" "Ctrl S" {
      LaunchOrFocusPlugin "session-manager" {
        floating true
        move_to_focused_tab true
      }
      SwitchToMode "normal"
    }

    bind "esc" { SwitchToMode "normal"; }
  }
  renametab {
    bind "esc" { UndoRenameTab; SwitchToMode "normal"; }
    bind "enter" { SwitchToMode "normal"; }
  }
  shared_except "normal" {
    bind "Ctrl c" { SwitchToMode "normal"; }
  }
}

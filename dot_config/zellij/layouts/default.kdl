layout {
  default_tab_template {
    pane size=1 borderless=true {
      plugin location="file:~/.config/zellij/plugins/zellaude.wasm"
    }
    children
    pane size=1 borderless=true {
      plugin location="file:~/.config/zellij/plugins/zjstatus.wasm" {
        color_rosewater "#f5e0dc"
        color_flamingo  "#f2cdcd"
        color_pink      "#f5c2e7"
        color_mauve     "#cba6f7"
        color_red       "#f38ba8"
        color_maroon    "#eba0ac"
        color_peach     "#fab387"
        color_yellow    "#f9e2af"
        color_green     "#a6e3a1"
        color_teal      "#94e2d5"
        color_sky       "#89dcfe"
        color_sapphire  "#74c7ec"
        color_blue      "#89b4fa"
        color_lavender  "#b4befe"
        color_text      "#cdd6f4"
        color_subtext1  "#bac2de"
        color_subtext0  "#a6adc8"
        color_overlay2  "#9399b2"
        color_overlay1  "#7f849c"
        color_overlay0  "#6c7086"
        color_surface2  "#585b70"
        color_surface1  "#45475a"
        color_surface0  "#313244"
        color_base      "#1e1e2e"
        color_mantle    "#181825"
        color_crust     "#11111b"

        format_left   "{mode} #[fg=$blue,bg=$mantle,bold]{session} {tabs}"
        format_center ""
        format_right  "{datetime}"
        format_space  "#[bg=$mantle]"
        format_hide_on_overlength "true"
        format_precedence "lrc"

        border_enabled  "false"

        hide_frame_for_single_pane "false"

        mode_normal        "#[bg=$blue,fg=$crust,bold] NORMAL "
        mode_locked        "#[bg=$red,fg=$crust,bold] LOCKED "
        mode_tmux          "#[bg=$peach,fg=$crust,bold] TMUX "
        mode_resize        "#[bg=$yellow,fg=$crust,bold] RESIZE "
        mode_pane          "#[bg=$teal,fg=$crust,bold] PANE "
        mode_tab           "#[bg=$green,fg=$crust,bold] TAB "
        mode_scroll        "#[bg=$flamingo,fg=$crust,bold] SCROLL "
        mode_enter_search  "#[bg=$mauve,fg=$crust,bold] SEARCH "
        mode_search        "#[bg=$mauve,fg=$crust,bold] SEARCH "
        mode_rename_tab    "#[bg=$pink,fg=$crust,bold] RENAME "
        mode_rename_pane   "#[bg=$pink,fg=$crust,bold] RENAME "
        mode_session       "#[bg=$lavender,fg=$crust,bold] SESSION "
        mode_move          "#[bg=$sky,fg=$crust,bold] MOVE "
        mode_default_to_mode "tmux"

        tab_normal              "#[fg=$overlay0,bg=$mantle] {index} {name} {fullscreen_indicator}{sync_indicator}{floating_indicator}"
        tab_active              "#[fg=$text,bg=$surface0,bold,italic] {index} {name} {fullscreen_indicator}{sync_indicator}{floating_indicator}"
        tab_separator           "#[fg=$surface0,bg=$mantle] | "
        tab_fullscreen_indicator "[] "
        tab_sync_indicator       "<> "
        tab_floating_indicator   "~  "

        datetime          "#[fg=$overlay2,bg=$mantle,bold] {format} "
        datetime_format   "%Y-%m-%d %H:%M"
        datetime_timezone "Asia/Tokyo"
      }
    }
  }
  tab {
    pane
  }
}

#!/bin/bash

source "$CONFIG_DIR/colors.sh"
source "$CONFIG_DIR/icons.sh"

FONT="PlemolJP Console NF"
ITEM_DIR="$CONFIG_DIR/items"

##### Bar Appearance #####
sketchybar --bar \
  height=36 \
  notch_display_height=36 \
  blur_radius=0 \
  position=top \
  sticky=on \
  displays=all \
  padding_left=8 \
  padding_right=28 \
  margin=0 \
  y_offset=0 \
  color=$BAR_COLOR \
  shadow=off \
  topmost=window

##### Default Item Properties #####
sketchybar --default \
  icon.font="$FONT:Bold:18.0" \
  icon.color=$ICON_DEFAULT \
  icon.y_offset=0 \
  label.font="$FONT:Regular:17.0" \
  label.color=$LABEL_DEFAULT \
  background.drawing=off \
  padding_left=4 \
  padding_right=4 \
  label.padding_left=4 \
  label.padding_right=4 \
  icon.padding_left=6 \
  icon.padding_right=2

##### Left Items #####
source "$ITEM_DIR/front_app.sh"
source "$ITEM_DIR/spaces.sh"
source "$ITEM_DIR/media.sh"

##### Right Items #####
source "$ITEM_DIR/clock.sh"
source "$ITEM_DIR/cpu.sh"     # cpu → popup.cpu (graph inside popup)
source "$ITEM_DIR/memory.sh"  # memory → popup.memory (graph inside popup)
source "$ITEM_DIR/brew.sh"
source "$ITEM_DIR/battery.sh"
source "$ITEM_DIR/wifi.sh"
source "$ITEM_DIR/claude.sh"
source "$ITEM_DIR/ime.sh"

##### Force Update #####
sketchybar --update

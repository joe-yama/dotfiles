# Default: work identity
[user]
name = "{{ .identity.work.name }}"
email = "{{ .identity.work.email }}"

[ui]
default-command = "status"
pager = "delta"

[ui.diff]
tool = ["delta", "--color-only"]

# Personal repos: ~/repo/github-personal/joe-yama/
[[--scope]]
--when.repositories = ["~/repo/github-personal/joe-yama"]
user.name = "{{ .identity.personal.name }}"
user.email = "{{ .identity.personal.email }}"

# Personal repos: ~/repo/github.com/joe-yama/
[[--scope]]
--when.repositories = ["~/repo/github.com/joe-yama"]
user.name = "{{ .identity.personal.name }}"
user.email = "{{ .identity.personal.email }}"

# chezmoi source directory: ~/dotfiles (outside ghq's ~/repo tree)
[[--scope]]
--when.repositories = ["~/dotfiles"]
user.name = "{{ .identity.personal.name }}"
user.email = "{{ .identity.personal.email }}"

{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "local-llm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local LLM (MacBook Pro via Tailscale)",
      "options": {
        "baseURL": "https://josukes-macbook-pro.tail97ab8.ts.net/v1"
      },
      "models": {
        "qwen38-flash-next": {
          "name": "Qwen 3.8-Flash-Next (mlx-serve 4bit, 262K)",
          "limit": {
            "context": 262144,
            "output": 65536
          }
        },
        "qwen38-flash-next-uncensored": {
          "name": "Qwen 3.8-Flash-Next uncensored (mlx-serve mixed 4/8bit, 262K)",
          "limit": {
            "context": 262144,
            "output": 65536
          }
        }
      }
    }
  },
  "model": "local-llm/qwen38-flash-next",
  "small_model": "local-llm/qwen38-flash-next"
}

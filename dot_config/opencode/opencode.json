            "output": 65536
          }
        },
        "qwen38-27b": {
          "name": "Qwen 3.8-27B (GGUF Q8 + MTP)",
          "limit": {
            "context": 131072,
            "output": 32768
          }
        },
        "qwen38-27b-mlx": {
          "name": "Qwen 3.8-27B (MLX 8bit, vision)",
          "limit": {
            "context": 131072,
            "output": 32768
          }
        },
        "qwen38-27b-fast": {
          "name": "Qwen 3.8-27B (MLX 4bit, fast)",
          "limit": {
            "context": 131072,
            "output": 32768
          }
        },
        "qwen38-abliterated": {
          "name": "Qwen 3.8-27B abliterated (GGUF Q8)",
          "limit": {
            "context": 131072,
            "output": 32768
          }
        }
      }
    }

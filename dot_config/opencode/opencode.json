{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "local-llm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local LLM (MacBook Pro via Tailscale)",
      "options": {
        "baseURL": "https://josukes-macbook-pro.tail97ab8.ts.net/v1"
      },
      "models": {
        "qwen38-flash-next": {
          "name": "Qwen 3.8-Flash-Next (GGUF UD-Q3_K_XL, 262K)",
